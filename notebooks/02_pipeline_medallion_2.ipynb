    "FUENTE     = BASE / \"data\" / \"fuente\"\n",
    "DIR_VENTAS = FUENTE / \"ventas\"\n",
    "DIR_INV    = FUENTE / \"inventario\"\n",
    "DIR_M      = {\"v1\": FUENTE / \"maestros\" / \"v1\", \"v2\": FUENTE / \"maestros\" / \"v2\"}\n",
    "DIR_LOGS   = BASE / \"logs\"\n",
