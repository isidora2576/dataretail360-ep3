    "## 2. Conexión con SQLAlchemy\n",
    "Se usa `create_engine` con el dialecto `mssql+pyodbc`. `fast_executemany=True` acelera la inserción de ~500.000 filas."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2026-10-30 00:57:13 | INFO    | CONEXION   | Conectado a SQL Server DESKTOP-DQ0SJAT\\SQLEXPRESS · base DataRetail360\n"
     ]
    }
   ],
   "source": [
    "def crear_motor(servidor=SERVIDOR, base=BASE_DATOS):\n",
    "    params = urllib.parse.quote_plus(\n",
    "        f\"DRIVER={{{DRIVER}}};SERVER={servidor};DATABASE={base};\"\n",
    "        \"Trusted_Connection=yes;TrustServerCertificate=yes;\")\n",
    "    return create_engine(f\"mssql+pyodbc:///?odbc_connect={params}\",\n",
    "                         fast_executemany=True, connect_args={\"timeout\": 10})\n",
    "\n",
    "def probar_conexion(motor):\n",
    "    with motor.connect() as con:\n",
    "        return con.execute(text(\"SELECT @@SERVERNAME, DB_NAME()\")).one()\n",
    "\n",
    "try:\n",
    "    engine = crear_motor()\n",
    "    servidor, base = probar_conexion(engine)\n",
    "    log(\"CONEXION\").info(f\"Conectado a SQL Server {servidor} · base {base}\")\n",
    "except Exception:\n",
    "    fallar(\"CONEXION\")\n",
    "    raise"
   ]
  },
